{
  "manifest_version": 3,
  "name": "Real Estate Lead Catcher",
  "version": "0.1.0",
  "description": "Captura leads de grupos de Facebook hacia tu CRM personal sin riesgo de ban.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/groups/*"],
      "js": ["content/observer.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Real Estate Lead Catcher"
  },
  "options_page": "options/options.html"
}
