{
  "manifest_version": 3,
  "name": "Apple Price Catcher",
  "version": "0.6.1",
  "description": "Captura pasiva de listings de MacBook, iPhone, iPad y audífonos (Facebook Marketplace + grupos) hacia el CRM para descubrir precios de mercado.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/groups/*"],
      "js": ["content/observer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content/mp-selectors.js", "content/mp-extract.js", "content/marketplace.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Apple Price Catcher"
  },
  "options_page": "options/options.html"
}
