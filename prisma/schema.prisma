generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  USER
}

model GoogleOAuthToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventarioConfig {
  id            String    @id @default("singleton")
  spreadsheetId String    @default("")
  sheetName     String    @default("Sheet1")
  cachedCsv     String?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Plantilla {
  id        String   @id @default(cuid())
  pregunta  String
  respuesta String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Real estate ────────────────────────────────────────────────────────────────

enum ListingStatus {
  ACTIVE
  SOLD
  SUSPENDED
  OVERPRICED
}

enum PriceChangeType {
  INITIAL
  INCREASE
  DECREASE
}

enum ScrapeRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Zone {
  id                  String   @id @default(cuid())
  name                String   @unique
  searchUrl           String
  locationKeywords    Json     @default("[]")
  desarrolloKeywords  Json     @default("[]")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scrapeRuns ScrapeRun[]
}

model ScrapeRun {
  id                String          @id @default(cuid())
  zoneId            String?
  zoneName          String          // copia para mostrar si la zona se borra
  status            ScrapeRunStatus @default(RUNNING)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  listingsNew       Int             @default(0)
  listingsUpdated   Int             @default(0)
  listingsUnchanged Int             @default(0)
  listingsSuspended Int             @default(0)
  error             String?

  zone Zone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([zoneId])
  @@index([startedAt])
}

model Listing {
  id           String        @id @default(cuid())
  sourceId     String        @unique // ID de Inmuebles24 extraído de la URL
  sourceUrl    String
  title        String
  zona         String
  desarrollo   String?
  price        Float
  currency     String        @default("MXN")
  m2Constructed Float?
  m2Total      Float?
  bedrooms     Int?
  bathrooms    Float?
  parkingSpaces Int?
  floor        Int?
  amenities    Json          @default("[]")
  images       Json          @default("[]")
  pricePerM2         Float?
  zoneAvgPricePerM2  Float?
  dealScore          Float?
  status       ListingStatus @default(ACTIVE)
  notes        String?
  firstSeenAt  DateTime      @default(now())
  lastSeenAt   DateTime      @default(now())
  lastCheckedAt DateTime     @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  priceHistory PriceHistory[]

  @@index([zona])
  @@index([status])
  @@index([dealScore])
}

model PriceHistory {
  id         String          @id @default(cuid())
  listingId  String
  price      Float
  changeType PriceChangeType
  recordedAt DateTime        @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model SavedSearch {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String?
  filters   Json      @default("{}")
  listingId String?   // Si apunta a un listing específico
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([slug])
}