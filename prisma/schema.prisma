generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  USER
}

model GoogleOAuthToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventarioConfig {
  id            String    @id @default("singleton")
  spreadsheetId String    @default("")
  sheetName     String    @default("Sheet1")
  cachedCsv     String?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Plantilla {
  id        String   @id @default(cuid())
  pregunta  String
  respuesta String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Real estate ────────────────────────────────────────────────────────────────

enum ListingStatus {
  ACTIVE
  SOLD
  SUSPENDED
  OVERPRICED
}

enum PriceChangeType {
  INITIAL
  INCREASE
  DECREASE
}

enum ScrapeRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Zone {
  id                 String   @id @default(cuid())
  name               String   @unique
  searchUrl          String
  locationKeywords   Json     @default("[]")
  desarrolloKeywords Json     @default("[]")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  scrapeRuns ScrapeRun[]
}

model ScrapeRun {
  id                String          @id @default(cuid())
  zoneId            String?
  zoneName          String // copia para mostrar si la zona se borra
  status            ScrapeRunStatus @default(RUNNING)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  listingsNew       Int             @default(0)
  listingsUpdated   Int             @default(0)
  listingsUnchanged Int             @default(0)
  listingsSuspended Int             @default(0)
  error             String?

  zone Zone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([zoneId])
  @@index([startedAt])
}

model Listing {
  id                String        @id @default(cuid())
  sourceId          String        @unique // ID de Inmuebles24 extraído de la URL
  sourceUrl         String
  title             String
  zona              String
  desarrollo        String?
  price             Float
  currency          String        @default("MXN")
  m2Constructed     Float?
  m2Total           Float?
  bedrooms          Int?
  bathrooms         Float?
  parkingSpaces     Int?
  floor             Int?
  amenities         Json          @default("[]")
  images            Json          @default("[]")
  pricePerM2        Float?
  zoneAvgPricePerM2 Float?
  dealScore         Float?
  status            ListingStatus @default(ACTIVE)
  notes             String?
  firstSeenAt       DateTime      @default(now())
  lastSeenAt        DateTime      @default(now())
  lastCheckedAt     DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  priceHistory     PriceHistory[]
  clienteContactos ClienteContacto[]

  @@index([zona])
  @@index([status])
  @@index([dealScore])
}

model PriceHistory {
  id         String          @id @default(cuid())
  listingId  String
  price      Float
  changeType PriceChangeType
  recordedAt DateTime        @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model SavedSearch {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String?
  filters   Json      @default("{}")
  listingId String? // Si apunta a un listing específico
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([slug])
}

// ── CRM ────────────────────────────────────────────────────────────────────────

enum ClienteEtapa {
  A // Cierre < 90 días — cadencia semanal
  B // 90-180 días — cadencia quincenal
  C // Largo plazo / referidos / SOI — cadencia mensual
  D // No calificado / muerto — trimestral o purga
}

enum ClienteType {
  COMPRADOR
  VENDEDOR
  AMBOS
  PASADO
}

enum ClienteFuente {
  REFERIDO
  FACEBOOK
  INMUEBLES24
  LLAMADA
  EVENTO
  SOI
  OTRO
}

enum ContactoTipo {
  LLAMADA
  WHATSAPP
  EMAIL
  VISITA
  EVENTO
  NOTA
  OTRO
}

enum ContactoEstado {
  PLANEADO
  REALIZADO
  OMITIDO
}

model Cliente {
  id                 String        @id @default(cuid())
  nombre             String
  telefono           String? // null cuando se captura desde FB y no tenemos número aún
  telefonoVerificado Boolean       @default(false)
  email              String?
  emailVerificado    Boolean       @default(false)
  type               ClienteType   @default(COMPRADOR)
  etapa              ClienteEtapa  @default(C)
  fuente             ClienteFuente @default(OTRO)
  motivacion         String?
  timeline           String? // texto libre: "3-6 meses", "antes de junio"
  presupuestoMin     Float?
  presupuestoMax     Float?
  referredById       String?
  referredByName     String? // si no está en el CRM
  tags               Json          @default("[]")
  spouseName         String?
  spousePhone        String?
  birthday           DateTime?
  notasPerma         String?
  ultimoContactoAt   DateTime?
  proximoContactoAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  referredBy Cliente?          @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  Cliente[]         @relation("Referrals")
  contactos  ClienteContacto[]

  @@index([etapa])
  @@index([type])
  @@index([proximoContactoAt])
}

model ClienteContacto {
  id              String         @id @default(cuid())
  clienteId       String
  tipo            ContactoTipo
  estado          ContactoEstado @default(PLANEADO)
  fechaProgramada DateTime
  realizadoAt     DateTime?
  resumen         String?
  listingId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cliente Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([estado, fechaProgramada])
}

// ── API Keys (para la extensión de Chrome y futuras integraciones) ────────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String // "Mi extensión Chrome", "Zapier", etc.
  keyHash    String    @unique // sha256 del key — nunca guardamos el texto plano
  prefix     String // primeros 8 chars del key para mostrar en UI ("rsk_abcd...")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ── Upwork ───────────────────────────────────────────────────────────────────

model UpworkJob {
  id                 String    @id @default(cuid())
  uid                String    @unique // uid/href estable generado por content.js
  url                String
  title              String
  description        String?
  skills             Json      @default("[]")
  budget             String?
  proposals          Int?
  proposalText       String?
  clientSpent        Float?
  spentText          String?
  postedText         String?
  postedHours        Float?
  // Snapshot de postedHours tomado SOLO en la creación (nunca se sobreescribe
  // después) — la antigüedad real se calcula como tiempo transcurrido desde
  // firstSeenAt + esta foto inicial, en vez de confiar en postedHours/postedText
  // (que se congelan si el job se cae de los resultados) o en firstSeenAt solo
  // (que ignora que el job ya podía tener horas/días cuando lo vimos por primera vez).
  initialPostedHours Float?
  score              Float?
  reasons            Json      @default("[]")
  ganado             Boolean   @default(false)
  ganadoAt           DateTime?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([score])
  @@index([ganado])
}

model UpworkSettings {
  id            String   @id @default("singleton")
  minScoreAlert Int      @default(7)
  updatedAt     DateTime @updatedAt
}


// ── Electrónicos (reventa de MacBooks) ───────────────────────────────────────
//
// Listings capturados pasivamente por la extensión `marketplace/` (Facebook
// Marketplace + grupos). Los specs se parsean en el servidor
// (src/lib/electronicos/parse-specs.ts) y se pueden corregir a mano desde la UI
// (specsManual = true → el re-parseo ya no los toca).

enum ElecSource {
  FB_GROUP
  MARKETPLACE
}

enum ElecListingStatus {
  ACTIVO
  DESAPARECIDO
}

enum ElecZoneKind {
  COMPRA
  VENTA
  OTRA
}

model ElecListing {
  id            String            @id @default(cuid())
  externalId    String            @unique // "mp_<id>" o permalink del post del grupo
  url           String
  source        ElecSource
  sourceKey     String // "mp:macbook pro" / "fb:<slug del grupo>" — para detectar "desaparecido"
  sourceName    String
  category      String            @default("MACBOOK")
  title         String
  description   String?
  condition     String? // "Used - like new" (Marketplace)
  price         Float?
  originalPrice Float? // "reduced from" de Marketplace
  currency      String            @default("MXN")
  imageUrl      String?
  locationText  String?
  lat           Float?
  lng           Float?
  zoneId        String?
  zoneKind      ElecZoneKind      @default(OTRA)
  sellerName    String?
  sellerId      String?
  postedAt      DateTime?
  postedText    String?
  firstSeenAt   DateTime          @default(now())
  lastSeenAt    DateTime          @default(now())
  status        ElecListingStatus @default(ACTIVO)
  disappearedAt DateTime?
  soldConfirmed Boolean           @default(false) // FB mostró "Sold"/no disponible
  daysOnMarket  Float?

  // Specs parseados
  line            String? // AIR_13 | AIR_15 | PRO_13 | PRO_14 | PRO_16 | NEO_13
  chip            String? // "M1", "M3 Pro", "A18 Pro"...
  ramGb           Int?
  ssdGb           Int?
  year            Int?
  color           String?
  batteryCycles   Int?
  batteryHealth   Int?
  flags           Json    @default("{}")
  parseConfidence Float   @default(0)
  needsReview     Boolean @default(true)
  specsManual     Boolean @default(false)
  configKey       String? // "PRO_14|M3 Pro|18|512"
  parseNotes      String? // por qué la confianza es la que es

  opportunityScore Float?
  scoreReasons     Json      @default("[]")
  comprado         Boolean   @default(false)
  compradoAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  zone         ElecZone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  priceHistory ElecPriceHistory[]
  trade        ElecTrade?

  @@index([configKey])
  @@index([status])
  @@index([sourceKey])
  @@index([opportunityScore])
  @@index([lastSeenAt])
  @@index([updatedAt])
}

model ElecPriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  price      Float
  recordedAt DateTime @default(now())

  listing ElecListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// Cada vez que la extensión reporta haber visto una fuente (búsqueda de
// Marketplace o grupo) se registra/extiende una sesión. Un listing que no
// reaparece en N sesiones posteriores (en días distintos) se marca DESAPARECIDO.
model ElecCaptureSession {
  id         String   @id @default(cuid())
  sourceKey  String
  startedAt  DateTime @default(now())
  lastPingAt DateTime @default(now())
  seenCount  Int      @default(0)

  @@index([sourceKey, startedAt])
}

model ElecZone {
  id        String       @id @default(cuid())
  name      String       @unique
  kind      ElecZoneKind
  keywords  Json         @default("[]") // municipios / colonias (sin acentos, minúsculas)
  lat       Float?
  lng       Float?
  radiusKm  Float?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  listings   ElecListing[]
  tradesBuy  ElecTrade[]   @relation("TradeBuyZone")
  tradesSell ElecTrade[]   @relation("TradeSellZone")
}

model ElecSettings {
  id                String   @id @default("singleton")
  minScoreAlert     Int      @default(7)
  disappearSessions Int      @default(2) // sesiones (en días distintos) sin verlo
  disappearMinHours Int      @default(48)
  fastSaleDays      Int      @default(7)
  windowDays        Int      @default(60) // ventana de datos para la tabla de precios
  minSample         Int      @default(3)
  updatedAt         DateTime @updatedAt
}

model ElecTrade {
  id         String    @id @default(cuid())
  listingId  String?   @unique
  equipo     String
  line       String?
  chip       String?
  ramGb      Int?
  ssdGb      Int?
  buyPrice   Float
  buyDate    DateTime
  buyZoneId  String?
  sellPrice  Float?
  sellDate   DateTime?
  sellZoneId String?
  costs      Float     @default(0) // traslados, reparaciones, etc.
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  listing  ElecListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyZone  ElecZone?    @relation("TradeBuyZone", fields: [buyZoneId], references: [id], onDelete: SetNull)
  sellZone ElecZone?    @relation("TradeSellZone", fields: [sellZoneId], references: [id], onDelete: SetNull)
}
